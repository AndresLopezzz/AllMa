# ==========================================
# DJANGO CONFIGURATION
# ==========================================

# Secret Key - Generar uno nuevo para producción
# Puedes generarlo con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-CHANGE-THIS-IN-PRODUCTION

# Debug mode - NUNCA usar True en producción
DEBUG=True

# Hosts permitidos (separados por coma)
ALLOWED_HOSTS=localhost,127.0.0.1

# ==========================================
# DATABASE CONFIGURATION
# ==========================================

# PostgreSQL (Recomendado para producción)
DB_NAME=inventario_db
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_HOST=localhost
DB_PORT=5432

# ==========================================
# CLOUDINARY CONFIGURATION (Opcional por ahora)
# ==========================================

# Obtén tus credenciales en: https://cloudinary.com/console
# CLOUDINARY_CLOUD_NAME=tu_cloud_name
# CLOUDINARY_API_KEY=tu_api_key
# CLOUDINARY_API_SECRET=tu_api_secret

# ==========================================
# CORS CONFIGURATION (Frontend)
# ==========================================

# URLs del frontend que pueden hacer peticiones al backend
# Agregar URLs de producción cuando se despliegue
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==========================================
# NOTAS IMPORTANTES
# ==========================================

# 1. NUNCA subir el archivo .env real a GitHub
# 2. Copiar este archivo como .env y llenar con valores reales
# 3. En producción, usar variables de entorno del servidor
# 4. SECRET_KEY debe ser único y secreto en cada entorno
