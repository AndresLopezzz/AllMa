<edit_description>
Crear .env.example con todas las variables de entorno necesarias
</edit_description>

# Archivo de ejemplo para variables de entorno
# Copia este archivo a .env y configura los valores reales
# NO subas .env a control de versiones

# Clave secreta de Django (genera una nueva para producción)
SECRET_KEY=your-secret-key-here

# Modo debug (False en producción)
DEBUG=False

# Hosts permitidos (lista separada por comas)
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Base de datos PostgreSQL
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# Configuración de Cloudinary para almacenamiento de imágenes
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Orígenes permitidos para CORS (lista separada por comas)
CORS_ORIGINS=http://localhost:5173,https://yourdomain.com

# Configuración de papelera (opcional)
TRASH_TTL_DAYS=2
ENABLE_CLEAN_TRASH_ADMIN_ENDPOINT=False
CLEAN_TRASH_ADMIN_SECRET=your-admin-secret

# Configuración de seguridad HTTPS (para producción)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
