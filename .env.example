# Archivo de ejemplo de variables de entorno para el proyecto.
# Copia este archivo a `.env` y rellena los valores reales.
# NO subas tu `.env` al repositorio. Mantén este `.env.example` público
# con valores de ejemplo/instrucciones.
#
# Uso:
# 1) cp inventory/.env.example .env
# 2) editar .env con valores reales
#
# Notas:
# - Algunos entornos (Render, Railway, Heroku) esperan que configures
#   estas variables desde su panel en lugar de subir un .env.
# - Las listas CSV se separan por comas sin espacios: e.g. a.com,b.com

# ---------------------------------------------------------------------
# Django / seguridad
# ---------------------------------------------------------------------
SECRET_KEY=your-very-secret-key               # clave secreta de Django (mantener privada)
DEBUG=False                                  # False en producción, True en desarrollo
ALLOWED_HOSTS=localhost,127.0.0.1            # hosts permitidos (CSV)
# ---------------------------------------------------------------------

# ---------------------------------------------------------------------
# Base de datos (config actual usa DB_NAME/DB_USER/DB_PASSWORD)
# ---------------------------------------------------------------------
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
# Alternativa (si usas DATABASE_URL en lugar de variables separadas)
# DATABASE_URL=postgres://user:password@host:5432/dbname
# ---------------------------------------------------------------------

# ---------------------------------------------------------------------
# CORS (orígenes permitidos por la API)
# Ejemplo: CORS_ORIGINS=https://app.example.com,http://localhost:5173
# ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# ---------------------------------------------------------------------

# ---------------------------------------------------------------------
# Cloudinary (para almacenamiento de media)
# ---------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# ---------------------------------------------------------------------

# ---------------------------------------------------------------------
# Seguridad / HTTPS y cookies
# Ajusta según tu entorno de despliegue.
# En muchos hosts 'SECURE_PROXY_SSL_HEADER' ya está configurado por la plataforma.
# ---------------------------------------------------------------------
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
# ---------------------------------------------------------------------

# ---------------------------------------------------------------------
# Configuración del proyecto (valores por defecto/ejemplo)
# ---------------------------------------------------------------------
TRASH_TTL_DAYS=2
ENABLE_CLEAN_TRASH_ADMIN_ENDPOINT=False
CLEAN_TRASH_ADMIN_SECRET=
# ---------------------------------------------------------------------

# ---------------------------------------------------------------------
# Opcional: variables para servicios externos, debugging, etc.
# ---------------------------------------------------------------------
# EMAIL_HOST=...
# EMAIL_PORT=...
# SENTRY_DSN=...
# OAUTH_CLIENT_ID=...
# OAUTH_CLIENT_SECRET=...
# ---------------------------------------------------------------------
